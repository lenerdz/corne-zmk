#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

&caps_word {
    continue-list = <UNDERSCORE>;
};

&led_strip {
    chain-length = <27>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        // 0 — base (padrão ZMK Studio)
        default_layer {
            display-name = "QWERTY";

            bindings = <
                &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T
                &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC

                &kp LCTRL &kp A     &kp S     &kp D     &kp F     &kp G
                &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT

                &kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B
                &kp N     &kp M     &kp COMMA &kp DOT   &kp LBKT  &kp RBKT

                &kp LGUI  &mo 1     &kp SPACE
                &kp RET   &mo 2     &kp RALT
            >;
        };

        // 1 — números e F-keys (antiga LOWER)
        fn1_layer {
            display-name = "FN1";

            bindings = <
                &kp GRAVE &kp F1    &kp F2    &kp F3    &kp F4    &kp F5
                &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11

                &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6
                &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL

                &mo 3     &mo 4     &mo 5     &kp F12   &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans

                &kp LGUI  &trans    &kp SPACE
                &kp RET   &trans    &kp RALT
            >;
        };

        // 2 — símbolos
        raise_layer {
            display-name = "RAISE";

            bindings = <
                &kp ESC   &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT
                &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR  &kp BSPC

                &kp LCTRL &studio_unlock &kp FSLH &kp BSLH &kp GRAVE &kp TILDE
                &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT  &kp LBRC  &kp RBRC

                &kp LSHFT &trans    &trans    &trans    &trans    &trans
                &kp UNDER &kp PLUS  &kp PIPE  &kp COLON &kp DQT   &kp QMARK

                &kp LGUI  &trans    &kp SPACE
                &kp RET   &trans    &kp RALT
            >;
        };

        // 3 — navegação (setas da antiga LOWER + extras)
        nav_layer {
            display-name = "NAV";

            bindings = <
                &kp ESC   &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &kp BSPC

                &kp LCTRL &kp HOME  &kp PG_DN &kp PG_UP &kp END   &kp INS
                &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp TAB   &kp DEL

                &kp LSHFT &trans    &trans    &trans    &trans    &trans
                &kp HOME  &kp PG_DN &kp PG_UP &kp END   &trans    &trans

                &kp LGUI  &trans    &kp SPACE
                &kp RET   &trans    &kp RALT
            >;
        };

        // 4 — Bluetooth + RGB (restante da antiga LOWER)
        sys_layer {
            display-name = "SYS";

            bindings = <
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
                &trans     &trans       &trans       &trans       &trans       &trans

                &rgb_ug RGB_TOG &rgb_ug RGB_EFF &rgb_ug RGB_HUI &rgb_ug RGB_HUD &rgb_ug RGB_BRI &rgb_ug RGB_BRD
                &trans          &trans          &trans          &trans          &trans          &trans

                &studio_unlock &trans &trans &trans &trans &trans
                &trans         &trans &trans &trans &trans &trans

                &kp LGUI  &trans    &kp SPACE
                &kp RET   &trans    &kp RALT
            >;
        };

        // 5 — mídia e atalhos úteis
        media_layer {
            display-name = "MEDIA";

            bindings = <
                &kp C_PWR  &kp C_SLEEP &trans    &trans    &trans    &caps_word
                &trans     &trans      &trans    &trans    &kp PSCRN &kp SLCK

                &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_BRI_DN &kp C_BRI_UP &kp CAPS
                &kp C_PREV &kp C_PP     &kp C_NEXT   &kp C_STOP   &trans       &trans

                &trans     &trans       &trans       &trans       &trans       &trans
                &trans     &trans       &trans       &trans       &trans       &trans

                &kp LGUI  &trans    &kp SPACE
                &kp RET   &trans    &kp RALT
            >;
        };
    };
};
