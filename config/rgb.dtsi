 * LED 18 = O
 * LED 19 = K
 * LED 20 = FSLH
 * LED 21 = ?
 * LED 22 = L
 * LED 23 = P
 * LED 24 = BSPC
 * LED 25 = SQT
 * LED 26 = ESC
 */

#endif